        "options": {}
      },
      "id": "search-props",
      "name": "Поиск объектов",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "functionCode": "const properties = $input.all()[0].json;\nconst clientData = items[0].json;\n\nif (!Array.isArray(properties) || properties.length === 0) {\n  return {\n    json: {\n      message: \"К сожалению, не нашел подходящих объектов 😔\\n\\nДавайте попробуем изменить параметры поиска?\",\n      phone: clientData.phone,\n      found: 0\n    }\n  };\n}\n\nlet message = `Отлично! Нашёл для вас ${properties.length} подходящих вариантов:\\n\\n`;\n\nproperties.slice(0, 3).forEach((prop, i) => {\n  message += `🏠 **Вариант ${i + 1}:**\\n`;\n  message += `${prop.title}\\n`;\n  message += `💰 Цена: ${Number(prop.price).toLocaleString('ru-RU')} ₽\\n`;\n  message += `📍 ${prop.location}\\n`;\n  message += `📐 Площадь: ${prop.area} м² | Комнат: ${prop.rooms}\\n\\n`;\n});\n\nif (properties.length > 3) {\n  message += `И ещё ${properties.length - 3} вариантов!\\n\\n`;\n}\n\nmessage += `Какой вариант интересен? Расскажу подробнее! 😊`;\n\nreturn {\n  json: {\n    message: message,\n    phone: clientData.phone,\n    found: properties.length,\n    properties: properties.slice(0, 3)\n  }\n};"
      },
      "id": "format-results",
      "name": "Форматировать",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
