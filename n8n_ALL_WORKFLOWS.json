      {
        "parameters": {
          "functionCode": "const client = $json;\nconst prefs = client.preferences || {};\n\nlet prefsText = '';\nif (prefs.type) prefsText += `Тип: ${prefs.type}\\n`;\nif (prefs.min_price) prefsText += `Бюджет от: ${Number(prefs.min_price).toLocaleString('ru-RU')} ₽\\n`;\nif (prefs.max_price) prefsText += `Бюджет до: ${Number(prefs.max_price).toLocaleString('ru-RU')} ₽\\n`;\nif (prefs.rooms) prefsText += `Комнат: ${prefs.rooms}\\n`;\nif (prefs.location) prefsText += `Локация: ${prefs.location}\\n`;\n\nconst message = `🔥 <b>ГОРЯЧИЙ ЛИД!</b>\\n\\n` +\n  `👤 Клиент: ${client.name}\\n` +\n  `📞 Телефон: ${client.phone}\\n` +\n  `📱 Канал: ${client.channel}\\n\\n` +\n  `<b>Предпочтения:</b>\\n${prefsText || 'Не указаны'}\\n\\n` +\n  `⏰ Время: ${new Date().toLocaleString('ru-RU')}\\n\\n` +\n  `<b>❗️ СВЯЖИТЕСЬ КАК МОЖНО СКОРЕЕ!</b>`;\n\nreturn {\n  json: {\n    message: message,\n    client: client\n  }\n};"
        },
