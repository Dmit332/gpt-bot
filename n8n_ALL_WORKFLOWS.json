        "parameters": {
          "functionCode": "// Извлекаем данные от Twilio WhatsApp\nconst body = $json.Body || $json.body || '';\nconst from = ($json.From || $json.from || '').replace('whatsapp:', '');\nconst clientId = from.replace(/[^0-9]/g, '');\n\nreturn {\n  json: {\n    client_id: clientId,\n    phone: from,\n    message: body,\n    channel: 'whatsapp',\n    timestamp: new Date().toISOString()\n  }\n};"
        },
