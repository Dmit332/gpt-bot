    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"notified\": false,\n  \"reason\": \"not_qualified\"\n}"
      },
      "id": "respond-no",
      "name": "Response (не квалифицирован)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 400]
    }
